    style.
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 240px));
        gap: 18px;
        margin-bottom: 22px;
      }

      .summary-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
      }

      .summary-card span {
        display: block;
        color: #777;
        font-size: 14px;
        margin-bottom: 8px;
      }

      .summary-card strong {
        display: block;
        font-size: 28px;
        color: #1f4e79;
      }

      .class-card {
        margin-bottom: 22px;
      }

      .class-summary-table {
        width: 100%;
        border-collapse: collapse;
      }

      .class-summary-table th,
      .class-summary-table td {
        padding: 13px 14px;
        text-align: left;
        border-bottom: 1px solid #eee;
      }

      .class-summary-table th {
        background: #f8f9fb;
      }

      .view-class-btn {
        border: none;
        background: #1f4e79;
        color: #fff;
        padding: 7px 13px;
        border-radius: 6px;
        cursor: pointer;
      }

      .view-class-btn:hover {
        opacity: .9;
      }

      .mini-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #e8eef5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: #1f4e79;
        overflow: hidden;
      }

      .mini-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .student-cell {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .sname {
        font-weight: 600;
      }

      .status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
      }

      .active-badge {
        background: #e7f7ed;
        color: #16803c;
      }

      .inactive-badge {
        background: #fceaea;
        color: #b42318;
      }

      .row-actions {
        display: flex;
        gap: 6px;
        justify-content: center;
      }

      .row-actions button {
        border: none;
        background: transparent;
        cursor: pointer;
        padding: 6px;
        font-size: 15px;
      }

      .edit-btn {
        color: #1f4e79;
      }

      .delete-btn {
        color: #c62828;
      }

      .empty-state {
        text-align: center;
        padding: 35px;
        color: #777;
      }

      .modal-overlay {
        display: none;
      }

      .modal-overlay.show {
        display: flex;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .field.span-2 {
        grid-column: span 2;
      }

      .field input,
      .field select {
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
      }

      @media(max-width: 800px) {
        .summary-grid {
          grid-template-columns: 1fr;
        }

        .form-grid {
          grid-template-columns: 1fr;
        }

        .field.span-2 {
          grid-column: span 1;
        }
      }

