        .sidebar-footer Akademi &middot; School Dashboard

      main.main
        .topbar
          .page-title
            h1 Settings
            p Manage your profile and preferences

          .search
            svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
              circle(cx="11", cy="11", r="7")
              path(d="M21 21l-4.3-4.3")
            input(type="text", id="searchInput", placeholder="Search here...")

          .topbar-right
            a.icon-btn(href="students/announcements.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9")
                path(d="M13.7 21a2 2 0 0 1-3.4 0")
              span.dot-badge
            a.user-chip(href="settings.pug")
              .avatar MR
              div
                .name Mithun Ray
                .role Student

        .card
          .card-header
            span Profile Settings
          .card-body
            form#profileForm
              .form-grid
                .field
                  label First Name
                  input#pFirst(type="text", value="Mithun")
                .field
                  label Last Name
                  input#pLast(type="text", value="Ray")
                .field
                  label Email
                  input#pEmail(type="email", value="mithun.ray@akademi.edu")
                .field
                  label Phone
                  input#pPhone(type="text", value="+1 234 555 0199")
                .field
                  label Class
                  input#pClass(type="text", value="Grade 8 - A")
                .field
                  label Notifications
                  select#pNotif
                    option All notifications
                    option Important only
                    option None
              .btn-row
                #cancelProfile.btn(type="button") Cancel
                button.btn.primary(type="submit") Save Changes

    #toastWrap.toast-wrap
    script.
      function toast(msg, type){
        const icon = type === "success"
          ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>'
          : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>';
        const el = document.createElement("div");
        el.className = "toast " + type;
        el.innerHTML = icon + "<span>" + msg + "</span>";
        document.getElementById("toastWrap").appendChild(el);
        setTimeout(() => el.remove(), 2600);
      }

      const defaults = { first:"Mithun", last:"Ray", phone:"+1 234 555 0199", cls:"Grade 8 - A", email:"mithun.ray@akademi.edu" };

      document.getElementById("profileForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const data = {
          first: document.getElementById("pFirst").value.trim(),
          last: document.getElementById("pLast").value.trim(),
          cls: document.getElementById("pClass").value.trim()
        };
        toast("Profile saved for " + data.first + " " + data.last + " (" + data.cls + ")", "success");
      });

      document.getElementById("cancelProfile").addEventListener("click", () => {
        document.getElementById("pFirst").value = defaults.first;
        document.getElementById("pLast").value = defaults.last;
        document.getElementById("pPhone").value = defaults.phone;
        document.getElementById("pClass").value = defaults.cls;
        document.getElementById("pEmail").value = defaults.email;
        document.getElementById("pNotif").selectedIndex = 0;
        toast("Changes discarded");
      });
