doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Akademi | Sign In
    link(rel="stylesheet", href="styles.css")
  body
    .auth-wrap
      .auth-card
        .auth-logo
          .mark A
          div
            h1 Akademi
            p School Management System

        h2 Sign in
        p.auth-sub Select your role to continue to your workspace.

        form#loginForm
          .role-grid#roleGrid
            label.role-option(for="role-teacher")
              input(type="radio", name="role", id="role-teacher", value="teacher")
              span.role-icon
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  path(d="M22 10L12 5 2 10l10 5 10-5z")
                  path(d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5")
              span
                span.r-name Class Teacher
                br
                span.r-desc Manage students, attendance & reports for your class

            label.role-option(for="role-librarian")
              input(type="radio", name="role", id="role-librarian", value="librarian")
              span.role-icon
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  path(d="M2 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z")
                  path(d="M22 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z")
              span
                span.r-name Librarian
                br
                span.r-desc Manage the library: books, borrowing & returns

            label.role-option(for="role-staff")
              input(type="radio", name="role", id="role-staff", value="staff")
              span.role-icon
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  path(d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3")
                  path(d="M1 14h6M9 8h6M17 16h6")
              span
                span.r-name Management / Admin
                br
                span.r-desc School-wide overview & admin (coming soon)

          button.btn.primary(type="submit", style="width:100%; justify-content:center;") Continue

        .auth-note
          strong Team note:
          |  This login is a placeholder. Real authentication & role-based access will be wired to the backend after the GitHub merge. Select a role to preview the relevant area.

    script.
      const roleHome = {
        teacher: "dashboard.pug",
        librarian: "library.pug",
        staff: "dashboard.pug"
      };

      function selectCard(label){
        document.querySelectorAll(".role-option").forEach(o => o.classList.remove("selected"));
        label.classList.add("selected");
      }
      document.querySelectorAll('.role-option input[name="role"]').forEach(r => {
        r.addEventListener("change", () => selectCard(r.closest(".role-option")));
      });
      document.querySelectorAll(".role-option").forEach(o => {
        o.addEventListener("click", () => {
          const input = o.querySelector('input[name="role"]');
          input.checked = true;
          selectCard(o);
        });
      });

      document.getElementById("loginForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const selected = document.querySelector('input[name="role"]:checked');
        if (!selected){ alert("Please select your role to continue."); return; }
        const role = selected.value;
        try { localStorage.setItem("akademi_role", role); } catch(err){}
        window.location.href = roleHome[role];
      });
