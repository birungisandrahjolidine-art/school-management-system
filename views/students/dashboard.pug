doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title EduSphere | Dashboard
    link(rel="stylesheet", href="/styles.css")
  body
    .app
      aside.sidebar
        a.logo(href="dashboard.pug")
          .mark E
          | EduSphere

        ul.nav
          li
            a.active(href="dashboard.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                rect(x="3", y="3", width="7", height="9", rx="1.5")
                rect(x="14", y="3", width="7", height="5", rx="1.5")
                rect(x="14", y="12", width="7", height="9", rx="1.5")
                rect(x="3", y="16", width="7", height="5", rx="1.5")
              | Dashboard
          li
            a(href="../students.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="8", r="4")
                path(d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5")
              | Students
          li
            a(href="attendance.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                rect(x="3", y="4", width="18", height="17", rx="2")
                path(d="M3 9h18M8 2v4M16 2v4")
                path(d="M8 14l2.5 2.5L16 11")
              | Attendance
          li
            a(href="../report.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M6 3h9l5 5v13H6z")
                path(d="M9 12h6M9 16h6M9 8h2")
              | Report
          li
            a(href="../library.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M2 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z")
                path(d="M22 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z")
              | Library
          li
            a(href="announcements.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M4 11a8 8 0 0 1 16 0v4l1 3H3l1-3z")
                path(d="M9 20a3 3 0 0 0 6 0")
              | Announcements

          li.section-label Support
          li
            a(href="help-center.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="12", r="9")
                path(d="M9.5 9.5a2.5 2.5 0 0 1 5 .5c0 1.7-2 1.7-2 3.5")
                circle(cx="12", cy="17", r=".3")
              | Help Center
          li
            a(href="../settings.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="12", r="3")
                path(d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.28c.6-.25 1-.83 1-1.48V2.7a2 2 0 1 1 4 0v.09c0 .65.4 1.23 1 1.48.6.25 1.3.14 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06c-.47.52-.58 1.22-.33 1.82.25.6.83 1 1.48 1H21a2 2 0 1 1 0 4h-.09c-.65 0-1.23.4-1.48 1z")
              | Settings
          li
            a(href="../signout.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                path(d="M16 17l5-5-5-5")
                path(d="M21 12H9")
              | Sign Out

        .sidebar-footer EduSphere &middot; School Dashboard

      main.main
        .topbar
          .page-title
            h1 Class Teacher Dashboard
            p Welcome back, here's what's happening in your class today

          .search
            svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
              circle(cx="11", cy="11", r="7")
              path(d="M21 21l-4.3-4.3")
            input(type="text", id="searchInput", placeholder="Search here...")

          .topbar-right
            a.icon-btn(href="announcements.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9")
                path(d="M13.7 21a2 2 0 0 1-3.4 0")
              span.dot-badge
            a.user-chip(href="../settings.pug", title="Class teacher profile")
              .avatar.avatar-img#teacherAvatar TA
              div
                .name Thomas Alabi
                .role Class Teacher &middot; Grade 8A

        .controls-row
          .controls-left
            label.pill-btn(style="display:inline-flex;", for="teacherPhotoInput")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="8", r="4")
                path(d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5")
              | Upload Profile Photo
            input(type="file", id="teacherPhotoInput", accept="image/*", hidden)
          .controls-right
            label.pill-select-wrap Class
              select#teacherClassSelect.pill-select
                option Grade 8 - A
                option Grade 8 - B
                option Grade 8 - C

        .stats-grid
          a.stat-card(href="/students")
            .stat-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="8", r="4")
                path(d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5")
            div
              .stat-value 428
              .stat-label Total Students
          a.stat-card(href="attendance.pug")
            .stat-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                rect(x="3", y="4", width="18", height="17", rx="2")
                path(d="M3 9h18M8 2v4M16 2v4")
                path(d="M8 14l2.5 2.5L16 11")
            div
              .stat-value 82%
              .stat-label On-time Attendance
          a.stat-card(href="announcements.pug")
            .stat-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M4 11a8 8 0 0 1 16 0v4l1 3H3l1-3z")
                path(d="M9 20a3 3 0 0 0 6 0")
            div
              .stat-value 6
              .stat-label New Announcements
          a.stat-card(href="../report.pug")
            .stat-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M6 3h9l5 5v13H6z")
                path(d="M9 12h6M9 16h6M9 8h2")
            div
              .stat-value 3
              .stat-label Reports Due

        .two-col
          .card
            .card-header
              span This Week's Attendance
            .card-body.tight
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Monday, Sept 23
                  .meta On time 82% &middot; Late 10% &middot; Absent 8%
                span.status.ontime On time
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Tuesday, Sept 24
                  .meta On time 88% &middot; Late 7% &middot; Absent 5%
                span.status.ontime On time
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Wednesday, Sept 25
                  .meta Annual Book Fair
                span.status.holiday Holiday
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Thursday, Sept 26
                  .meta On time 79% &middot; Late 12% &middot; Absent 9%
                span.status.late Late

          .card
            .card-header
              span Latest Announcements
              a(href="announcements.pug", style="color:#fff; font-size:12.5px; font-weight:600; font-family:inherit;") View all
            .card-body.tight
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Parent-teacher conference
                  .meta Posted Sept 24
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Mid-term report cards released
                  .meta Posted Sept 22
              .list-row
                div
                  div(style="font-weight:600; font-size:13.5px;") Annual Book Fair this week
                  .meta Posted Sept 20

    script.
      const teacherAvatar = document.getElementById("teacherAvatar");
      const teacherPhotoInput = document.getElementById("teacherPhotoInput");

      try {
        const saved = localStorage.getItem("teacher_photo");
        if (saved){ teacherAvatar.innerHTML = '<img src="' + saved + '" alt="Profile photo" />'; }
      } catch(err){}

      teacherPhotoInput.addEventListener("change", (e) => {
        const file = e.target.files[0];
        if (!file) return;
        if (!file.type.startsWith("image/")){ alert("Please choose an image file."); return; }
        const reader = new FileReader();
        reader.onload = () => {
          teacherAvatar.innerHTML = '<img src="' + reader.result + '" alt="Profile photo" />';
          try { localStorage.setItem("teacher_photo", reader.result); } catch(err){
            alert("Photo preview set. It may not persist across reloads due to storage limits.");
          }
        };
        reader.readAsDataURL(file);
      });

      document.getElementById("teacherClassSelect").addEventListener("change", (e) => {
        const c = e.target.value;
        document.querySelector(".user-chip .role").textContent = "Class Teacher · " + c;
        try { localStorage.setItem("teacher_class", c); } catch(err){}
      });
      try {
        const savedClass = localStorage.getItem("teacher_class");
        if (savedClass) document.getElementById("teacherClassSelect").value = savedClass;
      } catch(err){}
