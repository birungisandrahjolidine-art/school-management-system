        .sidebar-footer Akademi &middot; School Dashboard

      main.main
        .topbar
          .page-title
            h1 Announcements
            p School-wide updates and notices

          .search
            svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
              circle(cx="11", cy="11", r="7")
              path(d="M21 21l-4.3-4.3")
            input(type="text", id="searchInput", placeholder="Search here...")

          .topbar-right
            a.icon-btn(href="announcements.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9")
                path(d="M13.7 21a2 2 0 0 1-3.4 0")
              span.dot-badge
            a.user-chip(href="../settings.pug")
              .avatar MR
              div
                .name Mithun Ray
                .role Student

        .card
          .card-header
            span School Announcements
            button.pill-btn.primary#addAnnouncementBtn(style="border:none; background:rgba(255,255,255,0.18); color:#fff;")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M12 5v14M5 12h14")
              | Add
          .card-body.tight#announcementsList

    .modal-overlay#announcementModal
      .modal
        .modal-header
          h3 New Announcement
          button.modal-close#closeAnnouncementModal &times;
        .modal-body
          form#announcementForm
            .form-grid
              .field.span-2
                label Title
                input(type="text", id="anTitle", required, placeholder="e.g. Science fair postponed")
              .field.span-2
                label Message
                textarea#anBody(rows="4", required, placeholder="Write the announcement details...")
            .btn-row
              button.btn(type="button", id="cancelAnnouncement") Cancel
              button.btn.primary(type="submit") Publish

    .toast-wrap#toastWrap
    script.
      const announcements = [
        { title:"Parent-teacher conference scheduled", date:"Sept 24, 2024", body:"Conferences will be held October 3\u20134. Sign-up sheets are posted at the front office." },
        { title:"Mid-term report cards released", date:"Sept 22, 2024", body:"Report cards are now available under the Report tab for all grade levels." },
        { title:"Annual Book Fair this week", date:"Sept 20, 2024", body:"The book fair runs Wednesday through Friday in the main hall. Classes are dismissed early Wednesday." },
      ];

      const listEl = document.getElementById("announcementsList");
      const modal = document.getElementById("announcementModal");
      const icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a8 8 0 0 1 16 0v4l1 3H3l1-3z"/><path d="M9 20a3 3 0 0 0 6 0"/></svg>';

      function toast(msg, type){
        const wrap = document.getElementById("toastWrap");
        const tIcon = type === "success"
          ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>'
          : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>';
        const el = document.createElement("div");
        el.className = "toast " + type;
        el.innerHTML = tIcon + "<span>" + msg + "</span>";
        wrap.appendChild(el);
        setTimeout(() => el.remove(), 2600);
      }

      function render(){
        const q = document.getElementById("searchInput").value.trim().toLowerCase();
        const filtered = announcements.filter(a => !q || (a.title + a.body).toLowerCase().includes(q));
        if (!filtered.length){
          listEl.innerHTML = '<div class="empty-state">' + icon + '<p>No announcements</p><span>Be the first to post one.</span></div>';
          return;
        }
        listEl.innerHTML = filtered.map((a, i) => `
          <div class="tile" data-i="${announcements.indexOf(a)}">
            <div class="tile-icon">${icon}</div>
            <div>
              <div class="tile-title">${a.title}</div>
              <div class="tile-meta">Posted ${a.date}</div>
              <div class="tile-body">${a.body}</div>
            </div>
            <div class="tile-action"><button class="btn danger-del" title="Delete">Delete</button></div>
          </div>
        `).join("");
      }

      function openModal(){
        document.getElementById("anTitle").value = "";
        document.getElementById("anBody").value = "";
        modal.classList.add("show");
        setTimeout(() => document.getElementById("anTitle").focus(), 50);
      }
      function closeModal(){ modal.classList.remove("show"); }
      document.getElementById("addAnnouncementBtn").addEventListener("click", openModal);
      document.getElementById("closeAnnouncementModal").addEventListener("click", closeModal);
      document.getElementById("cancelAnnouncement").addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });

      document.getElementById("announcementForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const now = new Date();
        const date = now.toLocaleDateString("en-US", { month:"short", day:"numeric", year:"numeric" });
        announcements.unshift({
          title: document.getElementById("anTitle").value.trim(),
          body: document.getElementById("anBody").value.trim(),
          date: date
        });
        closeModal();
        render();
        toast("Announcement published", "success");
        document.getElementById("announcementForm").reset();
      });

      listEl.addEventListener("click", (e) => {
        if (e.target.classList.contains("danger-del")){
          const tile = e.target.closest(".tile");
          const idx = +tile.dataset.i;
          if (confirm('Delete "' + announcements[idx].title + '"?')){
            announcements.splice(idx, 1);
            render();
            toast("Announcement deleted", "success");
          }
        }
      });

      document.getElementById("searchInput").addEventListener("input", render);
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });

      render();
