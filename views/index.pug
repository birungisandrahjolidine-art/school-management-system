doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title EduSphere
    link(rel="stylesheet", href="index.css")
  body
    //- NAVIGATION
    nav.navbar
      .nav-container
        .logo
          .logo-icon E
          div
            h2 EduSphere
            span Management System
        .nav-links
          a.nav-link.active(href="#home") Home
          a.nav-link(href="#modules") Modules
          a.nav-link(href="#features") Features
          a.nav-link(href="#about") About
        a.btn-login(href="/teachers/login") Sign In
        button#mobileToggle.mobile-toggle &#9776;
    //- HERO
    section#home.hero
      .hero-content
        span.hero-badge EduSphere
        h1 Managing Education
          br
          span Made Simple
        p.
          A complete solution for managing teachers, students, finances and
          school operations. Streamline your school's administrative tasks
          with our easy-to-use platform.
        .hero-buttons
          a.btn-primary(href="/teachers/login") Get Started
          a.btn-outline(href="#modules") Explore Modules
      .hero-visual
        .visual-card.card-1
          .card-icon &#128218;
          div
            strong 1,200+
            small Students Enrolled
        .visual-card.card-2
          .card-icon &#128104;&#8205;&#127979;
          div
            strong 120
            small Teachers Staff
        .visual-card.card-3
          .card-icon &#9989;
          div
            strong 96%
            small Attendance Rate
    //- STATS BAR
    section.stats-bar
      .stat-item
        h2 1,248
        p Total Students
      .stat-divider
      .stat-item
        h2 120
        p Teachers
      .stat-divider
      .stat-item
        h2 36
        p Classes
      .stat-divider
      .stat-item
        h2 12
        p Departments
    //- MODULES
    section#modules.modules
      .section-header
        span Our Modules
        h2 Powerful Management Modules
        p Access different sections of the school management system tailored for each role.
      .modules-grid
        a.module-card(href="/teachers/login")
          .module-icon &#128104;&#8205;&#127979;
          h3 Teachers Portal
          p Manage teacher registration, attendance, leave, salaries and academic assignments.
          span.module-link Access Portal &rarr;
        a.module-card(href="/bursar/dashboard")
          .module-icon &#128176;
          h3 Bursar Portal
          p Handle fee payments, expenses, student finances and financial reporting.
          span.module-link Access Portal &rarr;
        a.module-card(href="/students/dashboard.pug")
          .module-icon &#128218;
          h3 Students Portal
          p View results, timetables, attendance records and school announcements.
          span.module-link Access Portal &rarr;
        a.module-card(href="/report.pug")
          .module-icon &#128202;
          h3 Reports & Analytics
          p Generate comprehensive reports on attendance, performance and finances.
          span.module-link Access Portal &rarr;
        a.module-card(href="#")
          .module-icon &#128221;
          h3 Examinations
          p Create exams, enter marks and publish results for all classes and terms.
          span.module-link Coming Soon &rarr;
        a.module-card(href="/library.pug")
          .module-icon &#128194;
          h3 Library
          p Track book inventory, manage loans and monitor library usage.
          span.module-link Access Portal &rarr;
    //- FEATURES
    section#features.features
      .section-header
        span Why Choose Us
        h2 Key Features
        p Built to simplify school administration with modern technology.
      .features-grid
        .feature-card
          .feature-icon &#9889;
          h3 Fast & Reliable
          p Quick access to all school data with a responsive and reliable platform.
        .feature-card
          .feature-icon &#128274;
          h3 Secure
          p Role-based access control ensures only authorized users see sensitive data.
        .feature-card
          .feature-icon &#128241;
          h3 Responsive Design
          p Access from any device - desktop, tablet or mobile phone.
        .feature-card
          .feature-icon &#128200;
          h3 Real-time Updates
          p Attendance, payments and reports update instantly across the system.
        .feature-card
          .feature-icon &#128196;
          h3 Report Generation
          p Generate detailed reports for finances, attendance and academic performance.
        .feature-card
          .feature-icon &#127912;
          h3 Easy to Use
          p Intuitive interface designed for teachers, bursars and administrators.
    //- ABOUT
    section#about.about
      .about-content
        span About Us
        h2 About EduSphere
        p.
          EduSphere is a comprehensive school management platform built to
          digitize and streamline administrative processes. Our system handles
          everything from teacher management to financial reporting, making
          school operations efficient and transparent.
        p.
          This project was developed as part of a school project to demonstrate
          the application of web technologies in solving real-world educational
          management challenges.
        .about-stats
          div
            strong 2026
            small Year Built
          div
            strong HTML/CSS/JS
            small Technologies
          div
            strong 6+
            small Modules
    //- FOOTER
    footer
      .footer-container
        .footer-col
          .footer-logo
            .logo-icon E
            div
              h3 EduSphere
              p Management System
          p.footer-desc A complete school management solution for modern educational institutions.
        .footer-col
          h4 Quick Links
          a(href="#home") Home
          a(href="#modules") Modules
          a(href="#features") Features
          a(href="#about") About
        .footer-col
          h4 Portals
          a(href="/teachers/login") Teachers Portal
          a(href="/bursar/dashboard") Bursar Portal
          a(href="/students/dashboard.pug") Students Portal
        .footer-col
          h4 Contact
          a(href="#") info@edusphere.com
          a(href="#") +256 700 000 000
          a(href="#") Kampala, Uganda
      .footer-bottom
        p &copy; 2026 EduSphere. All rights reserved.
    script(src="index.js")
