doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Salary Approvals - School Management System
    link(rel="stylesheet", href="teachers_salary_approval.css")
  body
    //- Sidebar
    aside.sidebar
      .logo
        h2 School MS
        p Management System
      nav
        a(href="teachers_dashboard.pug") Dashboard
        a(href="teachers_list.pug") Teachers
        a(href="teachers_salary.pug") Salaries
        a(href="teachers_salary_approval.pug").active Salary Approvals
        a(href="teachers_leave_management.pug") Leave Management
        a(href="teachers_profile.pug") My Profile
      .logout
        a(href="logout.pug") Logout

    //- Main Content
    main.main-content
      //- Top section
      header.top-bar
        div
          h1 Salary Approvals
          p Approve pending teacher salary payments
        #currentDate.current-date

      //- Approval Summary Cards
      section.summary-cards
        .summary-card
          h3 Pending Approval
          p 3
        .summary-card
          h3 Cleared Payments
          p 5
        .summary-card
          h3 Rejected
          p 1
        .summary-card
          h3 Total Amount Pending
          p UGX 4,300,000

      //- Filters
      section.filter-section
        input(type="text", id="searchApproval", placeholder="Search teacher by name, ID or subject...")
        select#filterStatus
          option(value="") All Status
          option(value="Pending") Pending
          option(value="Cleared") Cleared
          option(value="Rejected") Rejected

      //- Approval Table
      section.table-container
        table
          thead
            tr
              th Teacher ID
              th Name
              th Subject
              th Class
              th Net Salary
              th Payment Month
              th Submission Date
              th Status
              th Actions
          tbody#approvalTable
            tr
              td T003
