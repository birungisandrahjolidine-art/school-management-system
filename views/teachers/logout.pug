doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Logout - EduSphere
    link(rel="stylesheet", href="logout.css")
  body
    main.logout-container
      .logout-card
        .logo
          h2 EduSphere
          p Management System
        .icon ↪
        h1 Logout
        p#message.message
          | Are you sure you want to log out?
          br
          |  You will need to sign in again to access the system.
        .actions
          a.btn.btn-cancel(href="/teachers/dashboard") Cancel
          button#logoutBtn.btn.btn-logout(type="button") Yes, Logout
    script.
      const logoutBtn = document.getElementById("logoutBtn");
      const message = document.getElementById("message");

      logoutBtn.addEventListener("click", async function () {
        logoutBtn.disabled = true;
        message.innerHTML = "<strong>Signing you out...</strong>";

        try {
          await fetch("/api/auth/logout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
          });
        } catch (err) {
          // The cookie is cleared on the server; continue to the login page.
        }

        message.innerHTML = "<strong>You have been logged out successfully.</strong><br />Redirecting to login page...";

        setTimeout(function () {
          window.location.href = "/teachers/login";
        }, 1200);
      });
