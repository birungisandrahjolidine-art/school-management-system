doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Teacher Salaries - EduSphere
    link(rel="stylesheet", href="teachers_salary.css")
  body
    //- Sidebar
    aside.sidebar
      .logo
        h2 EduSphere
        p Management System
      nav
        a(href="teachers_dashboard.pug") Dashboard
        a(href="teachers_list.pug") Teachers
        a(href="teachers_attendence.pug") Attendance
        a(href="teachers_leave_management.pug") Leave Management
        a(href="teachers_salary.pug").active Salaries
        a(href="teachers_salary_payment.pug") Salary Payments
        a(href="teachers_profile.pug") My Profile
      .logout
        a(href="logout.pug") Logout

    //- Main Content
    main.main-content
      //- Top section
      header.top-bar
        div
          h1 Teacher Salaries
          p View and manage all teachers' salary records
        #currentDate.current-date

      //- Salary Summary Cards
      section.summary-cards
        .summary-card
          h3 Monthly Budget
          p UGX 18,500,000
        .summary-card
          h3 Paid This Month
          p UGX 14,200,000
        .summary-card
          h3 Pending Payment
          p UGX 4,300,000
        .summary-card
          h3 Total Teachers
          p 45

      //- Filters
      section.filter-section
        input(type="text", id="searchSalary", placeholder="Search teacher by name, ID or subject...")
        select#filterStatus
          option(value="") All Payment Status
          option(value="Paid") Paid
          option(value="Pending") Pending
          option(value="Partial") Partial

      //- Salary Table
      section.table-container
        table
          thead
            tr
              th Teacher ID
              th Name
              th Subject
              th Class
              th Basic Salary
              th Allowances
              th Deductions
              th Net Salary
              th Payment Status
              th Actions
          tbody#salaryTable
            tr
              td T001
              td John Bosco
              td Mathematics
              td S5
              td UGX 850,000
              td UGX 150,000
              td UGX 50,000
              td UGX 950,000
              td
                span.status.paid Paid
              td
                button.view-btn View
                button.print-btn Payslip
