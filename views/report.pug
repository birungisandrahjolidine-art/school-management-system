                path(d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5")
              | Students
          li
            a(href="students/attendance.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
