        .sidebar-footer EduSphere &middot; School Dashboard

      main.main
        .topbar
          .page-title
            h1 Report
            p Download and generate student reports

          .search
            svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
              circle(cx="11", cy="11", r="7")
              path(d="M21 21l-4.3-4.3")
            input(type="text", id="searchInput", placeholder="Search here...")

          .topbar-right
            a.icon-btn(href="students/announcements.pug")
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9")
                path(d="M13.7 21a2 2 0 0 1-3.4 0")
              span.dot-badge
            a.user-chip(href="settings.pug")
              .avatar MR
              div
                .name Mithun Ray
                .role Student

        .card
          .card-header
            span Available Reports
          .card-body.tight
            .tile
              .tile-icon
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  path(d="M6 3h9l5 5v13H6z")
                  path(d="M9 12h6M9 16h6M9 8h2")
              div
                .tile-title Mid-term Report Card &mdash; Grade 8A
                .tile-meta Generated Sept 22, 2024 &middot; PDF
              .tile-action
                button.btn.primary.download-btn(data-name="Mid-term Report Card") Download
            .tile
              .tile-icon
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  path(d="M6 3h9l5 5v13H6z")
                  path(d="M9 12h6M9 16h6M9 8h2")
              div
                .tile-title Monthly Attendance Summary &mdash; September
                .tile-meta Generated Sept 20, 2024 &middot; XLSX
              .tile-action
                button.btn.primary.download-btn(data-name="Monthly Attendance Summary") Download
            .tile
              .tile-icon
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  path(d="M6 3h9l5 5v13H6z")
                  path(d="M9 12h6M9 16h6M9 8h2")
              div
                .tile-title Behavior &amp; Conduct Notes
                .tile-meta Due Oct 1, 2024 &middot; Not yet generated
              .tile-action
                button#generateReportBtn.btn Generate

        .card
          .card-header
            span Generate New Report
          .card-body
            form#reportForm
              .form-grid
                .field
                  label Report Type
                  select#rType(required)
                    option Report Card
                    option Attendance Summary
                    option Behavior &amp; Conduct
                .field
                  label Class
                  select(required)
                    option Grade 8 - A
                    option Grade 8 - B
                    option Grade 9 - A
                    option Grade 9 - B
                .field
                  label Term
                  select
                    option Mid-term
                    option Final
                .field
                  label Format
                  select
                    option PDF
                    option XLSX
              .btn-row
                button.btn(type="reset") Reset
                button.btn.primary(type="submit") Generate Report

    #toastWrap.toast-wrap
    script.
      function toast(msg, type){
        const icon = type === "success"
          ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>'
          : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>';
        const el = document.createElement("div");
        el.className = "toast " + type;
        el.innerHTML = icon + "<span>" + msg + "</span>";
        document.getElementById("toastWrap").appendChild(el);
        setTimeout(() => el.remove(), 2600);
      }

      document.querySelectorAll(".download-btn").forEach(btn => {
        btn.addEventListener("click", () => toast("Downloading " + btn.dataset.name + "...", "success"));
      });

      document.getElementById("generateReportBtn").addEventListener("click", () => {
        toast("Behavior & Conduct report is being prepared", "success");
      });

      document.getElementById("reportForm").addEventListener("submit", (e) => {
        e.preventDefault();
        toast("Report generated successfully", "success");
        e.target.reset();
      });
