doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Student Fees - EduSphere
    link(rel="stylesheet", href="students_fees.css")
  body
    //- Sidebar
    aside.sidebar
      .logo
        h2 EduSphere
        p Bursar Portal

      nav
        a(href="bursar_dashboard.pug") Dashboard
        a(href="fee_payment.pug") Record Payment
        a.active(href="students_fees.pug") Student Fees
        a(href="#receipts") Receipts
        a(href="#expenses") Expenses
        a(href="#reports") Reports

      .logout
        a(href="../teachers/logout.pug") Logout

    //- Main Content
    main.main-content
      //- Top bar
      header.top-bar
        div
          h1 Student Fees
          p View all students' fees, payment records and balances
        .current-date#currentDate

      //- Summary Cards
      section.summary-cards
        .summary-card
          h3 Total Students
          p#totalStudents 9
        .summary-card
          h3 Total Fees Expected
          p#totalExpected UGX 10,150,000
        .summary-card
          h3 Total Collected
          p#totalCollected UGX 4,850,000
        .summary-card
          h3 Total Outstanding
          p#totalOutstanding UGX 5,300,000

      //- Filters
      section.filter-section
        input(type="text", id="searchStudent", placeholder="Search student by name, ID or class...")
        select#filterStatus
          option(value="") All Status
          option(value="Paid") Paid
          option(value="Partial") Partial
          option(value="Unpaid") Unpaid

      //- Students Fees Table
      section.table-container
        table
          thead
            tr
              th Student ID
              th Name
              th Class
              th Total Fees
              th Amount Paid
              th Balance Due
              th Payment Records
              th Status
          tbody#studentFeesTable
            tr
              td ST001
